{
  "name": "itr-lab-operations-dev",
  "private": true,
  "scripts": {
    "format:check": "prettier --check 'web/pages/*.html' 'web/scripts/*.js' 'web/styles/*.css'",
    "format": "prettier --write 'web/pages/*.html' 'web/scripts/*.js' 'web/styles/*.css'",
    "lint": "eslint web/scripts/*.js eslint.config.mjs",
    "test:backend": "python3 -m unittest discover -s tests -v",
    "test:browser": "python3 tests/browser_smoke.py && python3 tests/run_browser_suite.py",
    "test": "npm run test:backend && npm run test:browser"
  },
  "devDependencies": {
    "eslint": "10.11.0",
    "globals": "16.4.0",
    "prettier": "3.6.2"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  }
}
