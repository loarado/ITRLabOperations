{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "functions": {
    "api/index.py": {
      "includeFiles": "{web/**,data/**}",
      "excludeFiles": "{tests/**,docs/**,defaults/**,.itr-backups/**,*.md,restore_backup.py}",
      "maxDuration": 60
    }
  },
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
